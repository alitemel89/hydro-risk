{
  "name": "hydro-risk",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "test": "node --test tests/*.test.mjs",
    "dev:api": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "ng serve web",
    "db:migrate": "node database/migrate.mjs",
